<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_quick_production_list_tree" model="ir.ui.view">
        <field name="name">quick.production.list.tree</field>
        <field name="model">quick.production.list</field>
        <field name="arch" type="xml">
            <list string="Pending Production" editable="bottom" create="0" delete="0">
                <header>
                    <button name="action_produce_selected"
                            string="Produce Selected"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_fill_planned_qty"
                            string="Fill Planned Quantities"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <field name="mo_id"/>
                <field name="product_id"/>
                <field name="date_start" optional="show"/>
                <field name="qty_producing" string="Quantity"/>
                <field name="qty_total_str" string="Planned"/>
                <button name="action_edit_qty"
                        string="Edit"
                        type="object"
                        icon="edit"
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel')"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state in ('progress', 'to_close')"/>
                <button name="action_produce_line"
                        string="Done"
                        type="object"
                        icon="check"
                        class="btn-success"
                        invisible="state in ('done', 'cancel')"/>
                <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        icon="close"
                        class="btn-danger"
                        confirm="Are you sure you want to cancel this Manufacturing Order?"
                        invisible="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- Server Action to Populate and Open (Scoped per User) -->
    <record id="action_open_bulk_production" model="ir.actions.server">
        <field name="name">Produce All</field>
        <field name="model_id" ref="model_quick_production_list"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_bulk_production()
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_quick_production_bulk"
              name="Produce All"
              parent="menu_quick_production_root"
              action="action_open_bulk_production"
              sequence="2"/>

</odoo>